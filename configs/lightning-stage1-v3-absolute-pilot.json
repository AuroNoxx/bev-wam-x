{
  "framework": "pytorch-lightning==2.6.6",
  "precision": "bf16-mixed",
  "fused_adamw": true,
  "channels_last": true,
  "compile": false,
  "workers": 2,
  "conv_autotune": false,
  "log_every_n_steps": 10,
  "run_name": "stage1-v3-absolute-pilot10",
  "monitor": "trajectory/meanADE8_m",
  "training": {
    "lr": 5e-05,
    "max_epochs": 60,
    "min_epochs": 15,
    "patience": 10,
    "min_delta": 0.01
  },
  "objective": {
    "name": "flow_with_physical_endpoint_auxiliaries_v2",
    "auxiliary_min_t": 0.5,
    "position_scale_m": 5.0,
    "velocity_scale_mps": 2.0,
    "weights": {
      "fm": 1.0,
      "position": 0.2,
      "kinematics": 0.1,
      "unit_heading": 0.02,
      "negative_speed": 0.02
    }
  },
  "note": "Matched fresh-init 10-epoch pilot; only trajectory reference parameterization differs. Same 60-epoch LR schedule, stop at 6620 steps. No held-out test.",
  "manifest": "data/occ_v3/manifest.json",
  "preprocess_version": 3,
  "trajectory_parameterization": "absolute"
}