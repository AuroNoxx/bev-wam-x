{
  "framework": "pytorch-lightning==2.6.6",
  "precision": "bf16-mixed",
  "fused_adamw": true,
  "channels_last": true,
  "compile": false,
  "workers": 2,
  "conv_autotune": false,
  "log_every_n_steps": 10,
