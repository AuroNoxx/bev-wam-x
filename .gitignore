# Source/documentation repository only. Runtime assets stay local.
/*
!/.gitignore
!/.gitattributes
!/.python-version
!/AGENTS.md
!/README.md
!/requirements*.txt
!/pyproject.toml
!/uv.lock
!/configs/
!/docs/
!/scripts/
!/viewer/
!/v1_dual_system/
!/v2_mapless_wa/
!/v3_world_model/
!/v7_mapless_wa/
/v7_mapless_wa/*
!/v7_mapless_wa/config.yaml

# Generated/runtime directories anywhere
**/__pycache__/
**/.cache/
**/.venv*/
**/node_modules/
**/data/
**/datasets/
**/checkpoints/
**/weights/
**/logs/
**/artifacts/
**/runtime/
**/.pytest_cache/
**/wandb/
**/swanlog/

# Weights, data, archives, binaries and recordings
*.py[cod]
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin
*.npz
*.npy
*.pkl
*.pickle
*.h5
*.hdf5
*.parquet
*.arrow
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz
*.exe
*.dll
*.so
*.pyd
*.whl
*.egg
*.mp4
*.avi
*.mkv
*.bag
*.log
*.tmp
*.part

# Credentials and local-only configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
id_rsa*
id_ed25519*

